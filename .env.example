# === AI Provider API Keys (Server-Side Only) ===
# These keys are NEVER exposed to the browser. They are only accessible in Next.js Route Handlers.

# Google Gemini (via Google AI Studio)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Anthropic Claude
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (for GPT-4o, GPT-4o-mini)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# === Open-Weight Model Provider (GPT-OSS 120B) ===
# Select your provider: together | fireworks | vllm | ollama
OPENAI_COMPAT_PROVIDER=together

# Together AI (https://api.together.xyz)
TOGETHER_API_KEY=your_together_api_key_here

# Fireworks AI (https://fireworks.ai)
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Custom base URL for self-hosted providers (vLLM, Ollama, etc.)
# vLLM default: http://localhost:8000/v1
# Ollama default: http://localhost:11434/v1
OPENAI_COMPAT_BASE_URL=

# === Rate Limiting ===
RATE_LIMIT_CHAT_RPM=60
RATE_LIMIT_READ_RPM=120

# === Timeouts (milliseconds) ===
AI_TTFT_TIMEOUT_MS=8000
AI_REASONING_TIMEOUT_MS=25000
AI_MAX_RETRIES=2
